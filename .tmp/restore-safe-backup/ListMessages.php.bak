<?php

namespace App\Filament\Resources\Messages\Pages;

use App\Filament\Resources\Messages\MessageResource;
use Filament\Resources\Pages\ListRecords;

class ListMessages extends ListRecords
{
    protected static string $resource = MessageResource::class;

    protected function getHeaderActions(): array
    {
        return [];
    }

    public function getHeading(): string
    {
        $account = MessageResource::selectedWhatsappAccountFromRequest();

        if (! $account) {
            return parent::getHeading();
        }

        return 'رسائل ' . $account->name;
    }

    public function getSubheading(): ?string
    {
        $account = MessageResource::selectedWhatsappAccountFromRequest();

        if (! $account) {
            return null;
        }

        $sessionStatus = MessageResource::statusLabel($account->status);
        $sendingMode = MessageResource::sendingModeLabel($account->automatic_sending_enabled);
        $phoneNumber = $account->phone_number ?: '-';
        $modeNotice = $account->automatic_sending_enabled
            ? 'الإرسال التلقائي مفعل بفاصل عشوائي من 15 إلى 30 ثانية.'
            : 'الإرسال اليدوي مفعل، ولن تُرسل الرسائل تلقائيًا.';

        return "{$account->name} | {$phoneNumber} | {$sessionStatus} | {$sendingMode} | {$modeNotice}";
    }
}
